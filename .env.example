# Copy these into Vercel (Project -> Settings -> Environment Variables).
# For local work, copy this file to .env.local and fill it in.
# NEVER commit .env.local or paste real values into this file.

# --- Required ---------------------------------------------------------------
# Supabase: Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_KEY=            # the service_role / secret key
# Admin login password. Use 12+ characters.
ADMIN_PASSWORD=
# Your live address, no trailing slash, e.g. https://your-site.vercel.app
SITE_URL=
# Site timezone (IANA name)
NEXT_PUBLIC_SITE_TIMEZONE=Asia/Manila

# --- Google Calendar (optional) ---------------------------------------------
# Read: Calendar -> Settings -> "Secret address in iCal format"
GOOGLE_ICS_URL=
# Write: service account from your Google Cloud JSON key file
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=              # the private_key value; paste it as one line, keeping the \n characters
GOOGLE_CALENDAR_ID=              # ends in @group.calendar.google.com

# --- Email (optional; pick Gmail OR Resend) -----------------------------------
NOTIFY_EMAIL=                    # where new-request alerts go (defaults to the profile email)
EMAIL_FROM_NAME=
GMAIL_USER=
GMAIL_APP_PASSWORD=              # a Google "App password", not the normal password
RESEND_API_KEY=
EMAIL_FROM=
