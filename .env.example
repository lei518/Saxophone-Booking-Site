# ---------------------------------------------------------------------------
# Every setting the site uses. Copy this file to .env.local and fill it in.
# On Vercel, add the same names under Settings → Environment Variables.
# Never put real values in this file: it's meant to be shared and committed.
# ---------------------------------------------------------------------------

# --- Database (Supabase → Project Settings → API) --------------- REQUIRED --
SUPABASE_URL=
# The SECRET key (starts with sb_secret_), not the publishable one.
SUPABASE_SERVICE_KEY=

# --- Admin login ------------------------------------------------ REQUIRED --
# At least 12 characters. Four random words works well.
ADMIN_PASSWORD=

# --- Site ------------------------------------------------------------------
# The public address, no slash at the end. Used for links in his email and
# for share previews on Facebook/Messenger. Locally: http://localhost:3000
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_TIMEZONE=Asia/Manila

# --- Google Calendar: READ his busy times (optional) -----------------------
# His MAIN calendar → Settings and sharing → Integrate calendar →
# "Secret address in iCal format".
GOOGLE_ICS_URL=

# --- Google Calendar: WRITE approved gigs (optional) -----------------------
# From the service account's downloaded JSON file: "client_email".
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# From the same file: the "private_key" value, in double quotes, on one line.
GOOGLE_PRIVATE_KEY=""
# The GIGS calendar → Settings and sharing → Integrate calendar → Calendar ID.
# Ends in @group.calendar.google.com.
GOOGLE_CALENDAR_ID=

# --- Email: notify him of new requests (optional) --------------------------
# Leave all of these empty and emails are printed in the terminal instead.
# If both Gmail and Resend are filled in, Gmail is used.

# Where the new-request notification goes. Defaults to the profile email.
NOTIFY_EMAIL=
# Sender name shown in the inbox.
EMAIL_FROM_NAME=

# Option A: a Gmail account with 2-Step Verification and an App Password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Option B: Resend (resend.com). Without a verified domain it only delivers
# to the address you signed up with.
RESEND_API_KEY=
EMAIL_FROM=
